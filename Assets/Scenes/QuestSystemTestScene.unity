--- !u!114 &2115427412
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2115427411}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb5d46b9a3f714043af990e0e5059a04, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PirateGame.Quests.QuestNpc
  promptText: Talk
  key: 19
  range: 3
  npcName: Merchant
  npcAnimator: {fileID: 2115427415}
  shop: {fileID: 0}
  conversations:
  - label: "Quest B \u2014 rescued, choose reward"
    condition:
      quest: {fileID: 11400000, guid: 0453ce6d0bacd874db3e7819c4f4fb24, type: 2}
      statuses: 8
      stageIds:
      - Rescue_Talk
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: You came for me! I truly thought I was done for.
      gesture: 1
    - speaker: 
      text: Those brutes wanted the key to my strongbox. I'd have gone to the bottom
        of the sea before handing it over.
      gesture: 0
    - speaker: 
      text: "Please, let me repay you. Choose whichever you like \u2014 but choose
        wisely, I can only part with one."
      gesture: 0
    choices:
    - label: Weapon Upgrade  (+25% sword damage)
      action:
        action: 5
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response:
      - speaker: 
        text: "A fine blade deserves a keener edge. There \u2014 it'll bite deeper
          now."
        gesture: 1
      - speaker: 
        text: I'll make my way back to the shop now. Come and see me!
        gesture: 0
    - label: Merchant's Lucky Compass  (unique item)
      action:
        action: 5
        quest: {fileID: 0}
        key: 
        rewardIndex: 1
        item: {fileID: 0}
      response:
      - speaker: 
        text: "My lucky compass. It has never once steered me wrong \u2014 may it
          do the same for you."
        gesture: 1
      - speaker: 
        text: I'll make my way back to the shop now. Come and see me!
        gesture: 0
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
  - label: "Quest B \u2014 mid fight"
    condition:
      quest: {fileID: 11400000, guid: 0453ce6d0bacd874db3e7819c4f4fb24, type: 2}
      statuses: 8
      stageIds:
      - Active_Rescue
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: Behind you! Watch out!
      gesture: 0
    choices: []
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
  - label: "Quest B \u2014 discovered, not accepted"
    condition:
      quest: {fileID: 11400000, guid: 0453ce6d0bacd874db3e7819c4f4fb24, type: 2}
      statuses: 4
      stageIds: []
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: "Help! Please\u2026 get me out of here before they come back!"
      gesture: 0
    choices:
    - label: "Accept \u2014 hold on, I'll get you out."
      action:
        action: 1
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response:
      - speaker: 
        text: Hurry! They're coming!
        gesture: 0
    - label: Not now.
      action:
        action: 2
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response:
      - speaker: 
        text: "Don't leave me here\u2026"
        gesture: 0
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
  - label: "Quest B \u2014 investigating"
    condition:
      quest: {fileID: 11400000, guid: 0453ce6d0bacd874db3e7819c4f4fb24, type: 2}
      statuses: 8
      stageIds: []
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: "Careful \u2014 they'll be back any moment!"
      gesture: 0
    choices: []
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
