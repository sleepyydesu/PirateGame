--- !u!114 &1094869191
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1094869190}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb5d46b9a3f714043af990e0e5059a04, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PirateGame.Quests.QuestNpc
  promptText: Talk
  key: 19
  range: 3
  npcName: Merchant
  npcAnimator: {fileID: 1094869194}
  shop: {fileID: 1094869192}
  conversations:
  - label: After Quest B
    condition:
      quest: {fileID: 11400000, guid: 0453ce6d0bacd874db3e7819c4f4fb24, type: 2}
      statuses: 16
      stageIds: []
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: My rescuer! Thanks to you I'm back behind my counter where I belong.
      gesture: 0
    - speaker: 
      text: "And don't worry \u2014 your discount still stands. Always will."
      gesture: 1
    choices:
    - label: Browse your wares
      action:
        action: 7
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response: []
    - label: Farewell
      action:
        action: 0
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response: []
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
  - label: "Quest A \u2014 hand in item"
    condition:
      quest: {fileID: 11400000, guid: c9f3e6eed94210249953b6dffa465452, type: 2}
      statuses: 8
      stageIds:
      - Active_Return
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 11400000, guid: 155d347e611fd5a4e8eb665e1729ec41, type: 2}
    lines:
    - speaker: You
      text: I found this washed up near the wreck. Is this what you lost?
      gesture: 0
    - speaker: 
      text: "My strongbox! You found it! My ledgers, my savings\u2026 everything
        is in here."
      gesture: 1
    - speaker: 
      text: I am in your debt, friend. From now on you'll get ten percent off everything
        in my shop. Forever.
      gesture: 0
    - speaker: 
      text: Do come back and visit. I'll have fresh stock soon.
      gesture: 0
    choices: []
    onFinished:
      action: 6
      quest: {fileID: 0}
      key: delivered:merchant_item
      rewardIndex: 0
      item: {fileID: 11400000, guid: 155d347e611fd5a4e8eb665e1729ec41, type: 2}
  - label: "Quest A \u2014 searching"
    condition:
      quest: {fileID: 11400000, guid: c9f3e6eed94210249953b6dffa465452, type: 2}
      statuses: 8
      stageIds: []
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: "Any luck? Look along the beach and in the shallows by the wreck \u2014
        a small iron-bound strongbox."
      gesture: 0
    - speaker: 
      text: And mind yourself. Scavengers have been picking over the wreckage.
      gesture: 0
    choices: []
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
  - label: "Quest A \u2014 offer"
    condition:
      quest: {fileID: 11400000, guid: c9f3e6eed94210249953b6dffa465452, type: 2}
      statuses: 2
      stageIds: []
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: You there! Did you see it? That storm came out of nowhere and tore my
        ship apart!
      gesture: 0
    - speaker: 
      text: I made it to shore, but something very important went over the side with
        the cargo.
      gesture: 0
    - speaker: 
      text: It'll have washed up somewhere along the coast near the wreck. Would
        you help me find it?
      gesture: 0
    choices:
    - label: "Accept \u2014 I'll find it."
      action:
        action: 1
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response:
      - speaker: 
        text: Bless you! Search the beach and the shallows around the wreck.
        gesture: 1
    - label: Not now.
      action:
        action: 2
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response:
      - speaker: 
        text: "I understand\u2026 I'll be right here if you change your mind."
        gesture: 0
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
  - label: After Quest A
    condition:
      quest: {fileID: 11400000, guid: c9f3e6eed94210249953b6dffa465452, type: 2}
      statuses: 16
      stageIds: []
      requiredFlags: []
      forbiddenFlags: []
    requiresItem: {fileID: 0}
    lines:
    - speaker: 
      text: Welcome back, friend! Your ten percent is waiting for you.
      gesture: 0
    choices:
    - label: Browse your wares
      action:
        action: 7
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response: []
    - label: Farewell
      action:
        action: 0
        quest: {fileID: 0}
        key: 
        rewardIndex: 0
        item: {fileID: 0}
      response: []
    onFinished:
      action: 0
      quest: {fileID: 0}
      key: 
      rewardIndex: 0
      item: {fileID: 0}
